{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "willow",
  "name": "inveniam-docs-v2",
  "colors": {
    "primary": "#0055FF",
    "light": "#07C983",
    "dark": "#15803D"
  },
  "favicon": "/favicon.svg",
  "banner": {
      "content": "⚠️ NVNM Chain Testnet `nvnm-testnet-1` Genesis is **IN PROGRESS**. Endpoints and services may be unstable or unusable until genesis is complete. Keep an eye out here for updates! ⚠️",
      "dismissible": false
    },
  "navigation": {
    "tabs": [
      {
        "tab": "Home",
        "icon": "home",
        "groups": [
          {
            "group": "NVNM Chain",
            "pages": [
              "index",
              "/getting-started/how-to-connect-wallets-to-testnet"
            ]
          }
        ]
      },
      {
        "tab": "Node Operators",
        "icon": "server",
        "groups": [
          {
            "group": "Overview",
            "expanded": false,
            "icon": "football",
            "pages": [
              "operators/overview/getting-started",
              "operators/overview/what-are-governator-nodes"
            ]
          },
          {
            "group": "Node Setup",
            "expanded": false,
            "icon": "gears",
            "pages": [
              "operators/node-setup-and-deployment/validator-nodes/initial-setup-notes",
              "operators/node-setup-and-deployment/validator-nodes/running-a-node",
              "operators/node-setup-and-deployment/validator-nodes/becoming-a-validator",
              "operators/node-setup-and-deployment/validator-nodes/configuring-systemd-service"
            ]
          }
        ]
      },
      {
        "tab": "Reference",
        "icon": "book-atlas",
        "href": "resources/chain-parameters",
        "groups": [
          {
            "group": "Network Information",
            "icon": "network-wired",
            "pages": [
              "resources/network-details",
              "resources/chain-parameters",
              "resources/evm-precompiles",
              "resources/peers"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Inveniam",
          "href": "https://inveniam.io",
          "icon": "book-open-cover"
        },
        {
          "anchor": "Inveniam Hub",
          "href": "https://hub.inveniam.io",
          "icon": "newspaper"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/light.avif",
    "dark": "/logo/dark.avif"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:contact@nvnmchain.io"
      }
    ],
    "primary": {
      "type": "button",
      "label": "NVNM Hub",
      "href": "https://hub.inveniam.io"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/mintlify",
      "github": "https://github.com/mintlify",
      "linkedin": "https://linkedin.com/company/mintlify"
    }
  }
}
